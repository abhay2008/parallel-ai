# ==============================================================================
# Parallel AI (PAI) Environment Configuration
# ==============================================================================

# OpenRouter API Key for Cloud Reasoning (Nemotron 3 Ultra 550B, Llama 3.3 70B, DeepSeek R1)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Local LLM Inference (Ollama)
OLLAMA_API_BASE=http://localhost:11434/v1

# Google Gemini / Antigravity Agent Coordination (Optional for direct SDK usage)
GEMINI_API_KEY=your_gemini_api_key_here
